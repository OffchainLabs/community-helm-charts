    {
      "datasource": {
        "uid": "$Source"
      },
      "description": "HTTP→WebSocket upgrade failures, split into disjoint parts that stack to the `arb_feed_clients_failed_upgrade` total. **rate limited** is the per-IP limit rejections (`arb_feed_clients_limit_rejected`, rust v0.5+), which are a *subset* of failed upgrades — so it is broken out here rather than counted twice alongside **other** (TLS/mTLS handshake and protocol errors). On relays with no rejection counter the whole total shows as **other**.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": null
      },
      "gridPos": {
