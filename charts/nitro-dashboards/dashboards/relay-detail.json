      "repeat": "relayjob",
      "title": "Relays Detail [$relayjob]",
      "type": "row"
    },
    {
      "datasource": {
        "uid": "$Source"
      },
      "description": "Connected clients (`arb_feed_clients_current`) and, on the rust relay only, the caught-up subset being served new messages live (`arb_feed_clients_live`). A large current-minus-live gap means many clients are still draining backlog. Go relays export no `_live` series, so that series is absent on a nitro-node row.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {}
          }
        },
        "overrides": null
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "arb_feed_clients_current{cluster=~\"$cluster\",namespace=~\"$namespacepattern\", job=\"$relayjob\"}",
          "legendFormat": "current - {{pod}}",
          "refId": "A"
        },
        {
          "expr": "arb_feed_clients_live{cluster=~\"$cluster\",namespace=~\"$namespacepattern\", job=\"$relayjob\"}",
          "legendFormat": "live (caught up) - {{pod}}",
          "refId": "B"
        }
      ],
