{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "builtIn": 0,
        "datasource": {
          "uid": "$loki_datasource"
        },
        "enable": false,
        "expr": "{job=\"integrations/kubernetes/eventhandler\", cluster=~\"$cluster\", namespace=~\"$namespacepattern\", type=\"Warning\", kind=\"Pod\", name=~\"$pod\"} | logfmt | line_format \"{{.reason}}: {{.name}} — {{.msg}}\"",
        "hide": false,
        "iconColor": "rgba(130, 130, 140, 0.5)",
        "name": "K8s Warning Events",
        "target": {
          "limit": 1000,
          "matchAny": false,
          "tags": null,
          "type": ""
        }
      },
      {
        "builtIn": 0,
        "datasource": {
          "uid": "$loki_datasource"
        },
        "enable": false,
        "expr": "{job=\"integrations/kubernetes/eventhandler\", cluster=~\"$cluster\", namespace=~\"$namespacepattern\", type=\"Normal\", kind=\"Pod\", name=~\"$pod\"} | logfmt | reason=\"Killing\" | line_format \"Killing {{.name}} — {{.msg}}\"",
        "hide": false,
        "iconColor": "rgba(140, 120, 180, 0.6)",
        "name": "Pod Killed",
        "target": {
          "limit": 1000,
          "matchAny": false,
          "tags": null,
          "type": ""
        }
      },
      {
        "builtIn": 0,
        "datasource": {
          "uid": "$loki_datasource"
        },
        "enable": false,
        "expr": "{job=\"integrations/kubernetes/eventhandler\", cluster=~\"$cluster\", namespace=~\"$namespacepattern\", kind=~\"Deployment|StatefulSet\", name=~\"($pod_controller).*\"} | logfmt | line_format \"{{.kind}} {{.name}}: {{.reason}} — {{.msg}}\"",
        "hide": false,
        "iconColor": "rgba(90, 150, 220, 0.7)",
        "name": "Rollouts / Deployments",
        "target": {
          "limit": 1000,
          "matchAny": false,
          "tags": null,
          "type": ""
        }
      },
      {
        "builtIn": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "$Source"
        },
        "enable": false,
        "expr": "increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", pod=~\"$pod\"}[$__rate_interval]) > 0",
        "hide": false,
        "iconColor": "rgba(235, 175, 60, 0.8)",
        "name": "Pod Restarts",
        "tagKeys": "namespace,pod,container,cluster",
        "titleFormat": "{{pod}} / {{container}}"
      },
      {
        "builtIn": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "$Source"
        },
        "enable": false,
        "expr": "(increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", pod=~\"$pod\"}[$__rate_interval]) > 0) and on (cluster, namespace, pod, container) (kube_pod_container_status_last_terminated_reason{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", pod=~\"$pod\", reason=\"OOMKilled\"} == 1)",
        "hide": false,
        "iconColor": "rgba(220, 70, 70, 0.9)",
        "name": "OOMKilled",
        "tagKeys": "namespace,pod,container,cluster",
        "titleFormat": "{{pod}} / {{container}}"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": null,
      "repeat": "validatorjob",
      "title": "Validator Summary [$validatorjob]",
      "type": "row"
    },
    {
      "datasource": {
        "uid": "$Source"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {}
          }
        },
        "overrides": null
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(arb_validator_last_block_validated{namespace=~\"$namespacepattern\",job=\"$validatorjob\", cluster=~\"$cluster\"}[$__rate_interval])) by (pod, cluster)",
          "legendFormat": "{{pod}} - {{cluster}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(arb_validator_msg_count_validated{namespace=~\"$namespacepattern\",job=\"$validatorjob\", cluster=~\"$cluster\"}[$__rate_interval])) by (pod, cluster)",
          "legendFormat": "{{pod}} - {{cluster}}",
          "refId": "B"
        }
      ],
      "title": "Validation Rate",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "$Source"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {}
          }
        },
        "overrides": null
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(arb_inbox_latest_batch_message{namespace=~\"$namespacepattern\",job=\"$validatorjob\",cluster=~\"$cluster\"} - arb_validator_msg_count_validated{namespace=~\"$namespacepattern\",job=\"$validatorjob\",cluster=~\"$cluster\"}) by (pod, cluster)",
          "legendFormat": "{{pod}} - {{cluster}}",
          "refId": "A"
        },
        {
          "expr": "sum(arb_validator_last_block_in_last_batch{namespace=~\"$namespacepattern\",job=\"$validatorjob\", cluster=~\"$cluster\"} - arb_validator_last_block_validated{namespace=~\"$namespacepattern\",job=\"$validatorjob\", cluster=~\"$cluster\"}) by (pod, cluster)",
          "legendFormat": "{{pod}} - {{cluster}}",
          "refId": "B"
        }
      ],
      "title": "Validator Block Backlog",
      "transparent": false,
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Source",
        "multi": false,
        "name": "Source",
        "query": "prometheus",
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "arb1-.*"
          ],
          "value": [
            "arb1-.*"
          ]
        },
        "label": "Namespace Pattern",
        "name": "namespacepattern",
        "type": "textbox"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "uid": "$Source"
        },
        "includeAll": true,
        "label": "Clusters",
        "multi": true,
        "name": "cluster",
        "query": "label_values(arb_feed_clients_current{namespace=~\"$namespacepattern\"}, cluster)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "uid": "$Source"
        },
        "includeAll": true,
        "label": "Validator Jobs",
        "multi": true,
        "name": "validatorjob",
        "query": "label_values(chain_head_block{namespace=~\"$namespacepattern\", cluster=~\"$cluster\", pod=~\".*val.*\", job!~\".*current.*|.*timeboost.*\"}, job)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "hide": 0,
        "label": "Loki Datasource",
        "multi": false,
        "name": "loki_datasource",
        "query": "loki",
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "uid": "$Source"
        },
        "includeAll": true,
        "label": "Pods",
        "multi": true,
        "name": "pod",
        "query": "label_values(chain_head_block{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", job=~\"$validatorjob\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "uid": "$Source"
        },
        "hide": 2,
        "includeAll": true,
        "label": "Pod Controller",
        "multi": true,
        "name": "pod_controller",
        "query": "label_values(chain_head_block{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", job=~\"$validatorjob\", pod=~\"$pod\"}, pod)",
        "refresh": 2,
        "regex": "/^(.*?)(?:-[a-z0-9]+-[a-z0-9]{5}|-[0-9]+)$/",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Validator Summary",
  "uid": "community-validator_summary"
}
