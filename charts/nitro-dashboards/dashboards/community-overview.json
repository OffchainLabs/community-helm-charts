        "hide": false,
        "iconColor": "rgba(90, 150, 220, 0.7)",
        "name": "Rollouts / Deployments",
        "target": {
          "limit": 1000,
          "matchAny": false,
          "tags": null,
          "type": ""
        }
      },
      {
        "builtIn": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "$Source"
        },
        "enable": false,
        "expr": "increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", pod=~\"$pod\"}[$__rate_interval]) > 0",
        "hide": false,
        "iconColor": "rgba(235, 175, 60, 0.8)",
        "name": "Pod Restarts",
        "tagKeys": "namespace,pod,container,cluster",
        "titleFormat": "{{pod}} / {{container}}"
      },
      {
        "builtIn": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "$Source"
        },
        "enable": false,
        "expr": "(increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", pod=~\"$pod\"}[$__rate_interval]) > 0) and on (cluster, namespace, pod, container) (kube_pod_container_status_last_terminated_reason{cluster=~\"$cluster\", namespace=~\"$namespacepattern\", pod=~\"$pod\", reason=\"OOMKilled\"} == 1)",
        "hide": false,
        "iconColor": "rgba(220, 70, 70, 0.9)",
        "name": "OOMKilled",
        "tagKeys": "namespace,pod,container,cluster",
        "titleFormat": "{{pod}} / {{container}}"
