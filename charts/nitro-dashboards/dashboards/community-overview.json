      "description": "Gas rate (gas/s) as reported by the active sequencer. For the ArbOS gas-pricing target band, base-fee-vs-floor congestion and per-constraint saturation, see the Gas Pricing dashboard.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {}
          },
          "unit": "short"
        },
        "overrides": null
