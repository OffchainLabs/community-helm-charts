          "expr": "max(rate(arb_gas_used{cluster=~\"$cluster\", namespace=~\"$namespacepattern.*\"}[$__rate_interval]) and on (pod) (arb_sequencer_active{} == 1)) by (pod, cluster)",
          "legendFormat": "{{ pod }} - {{ cluster }}",
          "refId": "A"
        }
      ],
      "title": "Sequencer Gas Rate",
      "transparent": false,
      "type": "timeseries"
