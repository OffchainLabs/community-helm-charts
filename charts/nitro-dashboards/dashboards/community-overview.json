      "description": "Block sequencing time as reported from the active sequencer",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {}
          },
          "unit": "ns"
        },
        "overrides": null
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(arb_sequencer_block_creation{namespace=~\"$namespacepattern.*\"} and on (pod) (arb_sequencer_active{} == 1)) by (quantile, chain)",
          "legendFormat": "{{chain}} - {{ quantile }}",
          "refId": "A"
        }
      ],
      "title": "Block Creation Time By Quantile",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "uid": "$Source"
